<?xml version="1.0" encoding="utf-8"?>
<!--
  =====================================================================================
  Shah Abdul Latif University (SALU) Web Portal - Windows Server / IIS Configuration
  =====================================================================================
  Stack: Next.js 16 (Standalone Output) + Payload CMS 3.90.2 + SQLite (WAL Mode)
  Default Architecture:
    - IIS Application Request Routing (ARR 3.0) & URL Rewrite Reverse Proxy
    - Forwarding incoming HTTP/HTTPS traffic to http://localhost:3000
    - Backend Service: Managed via NSSM (SALU-Website Windows Service)
  =====================================================================================
-->
<configuration>
  <system.webServer>
    <!--
      1. WebSocket Support:
      Enables native WebSocket transport tunneling through IIS ARR for real-time
      connections, client hydration, and Next.js Fast Refresh if run in staging.
    -->
    <webSocket enabled="true" receiveBufferLimit="4194304" pingInterval="00:00:30" />

    <!--
      2. Security & Request Filtering:
      Payload CMS allows media file uploads up to 50MB (50,000,000 bytes).
      IIS default is 30MB; increase maxAllowedContentLength to 52,428,800 bytes (50MB).
      Protect sensitive backend assets from direct web access.
    -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="52428800" maxUrl="4096" maxQueryString="4096" />
        <hiddenSegments>
          <!-- Protect SQLite database file, backups, and environment secrets from direct HTTP access -->
          <add segment="data" />
          <add segment="backups" />
          <add segment=".env" />
          <add segment=".git" />
          <add segment=".agents" />
          <add segment="logs" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <!--
      3. URL Rewrite & Reverse Proxy Rules:
      Forwards all inbound HTTP/HTTPS requests to the local Node.js standalone instance at http://localhost:3000.
      
      CRITICAL PREREQUISITE FOR SERVER VARIABLES:
      To prevent IIS 500.50 errors when setting HTTP_X_* variables, run these commands once in an
      elevated administrator command prompt for your IIS site:
        %windir%\system32\inetsrv\appcmd.exe set config "SALU_Website" /section:rewrite/allowedServerVariables /+"[name='HTTP_X_FORWARDED_PROTO']"
        %windir%\system32\inetsrv\appcmd.exe set config "SALU_Website" /section:rewrite/allowedServerVariables /+"[name='HTTP_X_FORWARDED_HOST']"
        %windir%\system32\inetsrv\appcmd.exe set config "SALU_Website" /section:rewrite/allowedServerVariables /+"[name='HTTP_X_REAL_IP']"
        %windir%\system32\inetsrv\appcmd.exe set config "SALU_Website" /section:rewrite/allowedServerVariables /+"[name='HTTP_X_FORWARDED_FOR']"
    -->
    <rewrite>
      <rules>
        <!-- Optional Rule: Force HTTPS (Uncomment in production when SSL certificate is bound)
        <rule name="RedirectToHTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        -->

        <!-- Reverse Proxy Rule for HTTPS Inbound Requests -->
        <rule name="ReverseProxyToNextJS_HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="on" ignoreCase="true" />
          </conditions>
          <action type="Rewrite" url="http://localhost:3000/{R:1}" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
            <set name="HTTP_X_REAL_IP" value="{REMOTE_ADDR}" />
            <set name="HTTP_X_FORWARDED_FOR" value="{REMOTE_ADDR}" />
          </serverVariables>
        </rule>

        <!-- Reverse Proxy Rule for HTTP Inbound Requests (Fallback) -->
        <rule name="ReverseProxyToNextJS_HTTP" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Rewrite" url="http://localhost:3000/{R:1}" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="http" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
            <set name="HTTP_X_REAL_IP" value="{REMOTE_ADDR}" />
            <set name="HTTP_X_FORWARDED_FOR" value="{REMOTE_ADDR}" />
          </serverVariables>
        </rule>
      </rules>

      <!--
        4. Static File Caching Outbound Rules:
        Applies immutable long-term caching headers to Next.js static chunks and uploaded media assets
        proxied through ARR.
      -->
      <outboundRules>
        <rule name="AddCacheControlForStaticAssets" preCondition="IsStaticAsset">
          <match serverVariable="RESPONSE_Cache-Control" pattern=".*" />
          <action type="Rewrite" value="public, max-age=31536000, immutable" />
        </rule>
        <preConditions>
          <preCondition name="IsStaticAsset">
            <add input="{REQUEST_URI}" pattern="^/(_next/static/|media/)" />
            <add input="{RESPONSE_STATUS}" pattern="^200$" />
          </preCondition>
        </preConditions>
      </outboundRules>
    </rewrite>

    <!--
      5. HTTP Security Headers:
      Enforces defense-in-depth across all responses terminating at IIS.
    -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="X-XSS-Protection" value="1; mode=block" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=()" />
      </customHeaders>
    </httpProtocol>

    <!--
      6. Static Content MIME Types & Fallback Client Cache:
      Ensures standard web font, modern image formats, and JSON types are properly declared.
    -->
    <staticContent>
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
    </staticContent>

    <!--
      7. Custom Error Handling:
      Pass through custom error pages generated by Next.js (e.g. not-found.tsx, error.tsx).
    -->
    <httpErrors existingResponse="PassThrough" />

    <!--
      ===================================================================================
      ALTERNATIVE DEPLOYMENT: iisnode (When ARR Reverse Proxy is not installed/permitted)
      ===================================================================================
      If your Windows Server environment does not permit IIS Application Request Routing
      (ARR), you can run the standalone Next.js application in-process using iisnode.

      Instructions to switch from ARR to iisnode:
      1. Download and install iisnode (x64) on Windows Server:
         https://github.com/Azure/iisnode/releases
      2. Ensure .next/standalone/server.js exists.
      3. Comment out the ARR <rewrite> section above.
      4. Uncomment the <handlers>, <iisnode>, and alternative <rewrite> sections below.

      <handlers>
        <add name="iisnode" path=".next/standalone/server.js" verb="*" modules="iisnode" />
      </handlers>

      <iisnode
        nodeProcessCommandLine="&quot;%ProgramFiles%\nodejs\node.exe&quot;"
        node_env="production"
        nodeProcessCountPerApplication="1"
        maxConcurrentRequestsPerProcess="1024"
        maxNamedPipeConnectionRetry="100"
        namedPipeConnectionRetryDelay="250"
        asyncCompletionThreadCount="0"
        initialRequestBufferSize="4096"
        maxRequestBufferSize="65536"
        watchedFiles="web.config;.next\standalone\server.js"
        uncFileChangesPollingInterval="5000"
        gracefulShutdownTimeout="60000"
        loggingEnabled="true"
        logDirectory="logs\iisnode"
        debuggingEnabled="false"
        debuggerPortRange="5058-6058"
        debuggerPathSegment="debug"
        maxLogFileSizeInKB="10240"
        maxTotalLogFileSizeInKB="51200"
        maxLogFiles="20"
        devErrorsEnabled="false"
        flushResponse="false"
        enableXFF="true"
        promoteServerVars=""
      />

      <rewrite>
        <rules>
          <rule name="IISNodeInspector" patternSyntax="ECMAScript" stopProcessing="true">
            <match url="^.next/standalone/server.js\/debug[\/]?" />
          </rule>
          <rule name="NextStaticContent" stopProcessing="true">
            <match url="^(_next|public|media)/.*" />
            <action type="Rewrite" url="{R:0}" />
          </rule>
          <rule name="NextDynamicRoutes">
            <conditions>
              <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="True" />
            </conditions>
            <action type="Rewrite" url=".next/standalone/server.js" />
          </rule>
        </rules>
      </rewrite>
      ===================================================================================
    -->

  </system.webServer>
</configuration>
